#!/bin/bash
# C2PA Robustness Research Pipeline - Docker Wrapper
# Phase-based execution wrapper for easy Docker usage

set -e

# Configuration
IMAGE="${C2PA_IMAGE:-aitchem037/c2pa-research:latest}"
OUTPUT_DIR="${C2PA_DATA_DIR:-./c2pa-results}"
TOOLS_DIR="${C2PA_TOOLS_DIR:-./tools}"

# Create output directory
mkdir -p "$OUTPUT_DIR"

# Create model cache volumes if they don't exist
docker volume create huggingface-cache >/dev/null 2>&1 || true
docker volume create torch-cache >/dev/null 2>&1 || true

# Check if GPU is available
check_gpu() {
    # Check if nvidia runtime is configured in Docker
    if docker info 2>/dev/null | grep -qi "nvidia"; then
        return 0
    else
        return 1
    fi
}

# Helper function to run Docker
run_docker() {
    local use_gpu="$1"
    shift

    # Build volume mounts
    local volumes="-v $OUTPUT_DIR:/workspace/data"
    volumes="$volumes -v huggingface-cache:/workspace/.cache/huggingface"
    volumes="$volumes -v torch-cache:/workspace/.cache/torch"

    # Mount tools directory if it exists
    if [ -d "$TOOLS_DIR" ]; then
        volumes="$volumes -v $TOOLS_DIR:/workspace/tools"
    fi

    if [ "$use_gpu" = "true" ]; then
        if check_gpu; then
            docker run --rm --gpus all $volumes "$IMAGE" "$@"
        else
            echo "[!] GPU not available, running in CPU mode"
            docker run --rm $volumes "$IMAGE" "$@"
        fi
    else
        docker run --rm $volumes "$IMAGE" "$@"
    fi
}

# Helper function to create platform directories
create_platform_dirs() {
    local platforms=("instagram" "twitter" "facebook" "youtube" "tiktok" "whatsapp")

    for platform in "${platforms[@]}"; do
        mkdir -p "$OUTPUT_DIR/prepared_assets/platform_tests/$platform/uploads"
        mkdir -p "$OUTPUT_DIR/prepared_assets/platform_tests/$platform/returned"
    done
}

# Helper function to generate platform instructions
generate_platform_instructions() {
    cat > "$OUTPUT_DIR/PLATFORM_UPLOAD_INSTRUCTIONS.txt" << 'EOF'
========================================
PLATFORM TESTING INSTRUCTIONS
========================================

Assets have been distributed to platform folders.

WORKFLOW:
1. Navigate to: c2pa-results/prepared_assets/platform_tests/
2. For each platform folder:
   a. Find assets in the 'uploads/' subfolder
   b. Upload these assets to the respective platform
   c. Download them back from the platform
   d. Place downloads in the 'returned/' subfolder

3. After completing uploads/downloads for all platforms:
   a. Run: c2pa rename-returns    (standardizes filenames)
   b. Run: c2pa phase 3           (verifies C2PA and calculates metrics)

PLATFORMS TO TEST:
- instagram/    (images + videos)
- twitter/      (images + videos)
- facebook/     (images + videos)
- youtube/      (videos only)
- tiktok/       (videos only)
- whatsapp/     (images + videos)

NOTES:
- Maintain original filenames when possible
- If platform renames files, use descriptive names
- Document any upload/download issues in platform_notes.txt

For detailed instructions, see README_DOCKER.md section on Platform Testing.
EOF

    echo ""
    echo "+================================================================+"
    echo "|              PLATFORM TESTING SETUP COMPLETE                   |"
    echo "+================================================================+"
    echo ""
    cat "$OUTPUT_DIR/PLATFORM_UPLOAD_INSTRUCTIONS.txt"
    echo ""
    echo "Instructions saved to: $OUTPUT_DIR/PLATFORM_UPLOAD_INSTRUCTIONS.txt"
    echo ""
}

# Main command router
case "$1" in
    "phase")
        PHASE="$2"
        shift 2

        case "$PHASE" in
            "0")
                echo "[Phase 0: Asset Generation]"
                run_docker true phase0 "$@"
                ;;

            "1")
                echo "[Phase 1: C2PA Manifest Embedding]"
                run_docker false phase1 "$@"
                ;;

            "2")
                echo "[Phase 2: Transformation Pipeline]"
                run_docker false phase2 "$@"
                ;;

            "2.5")
                echo "[Phase 2.5: Platform Testing Setup]"
                echo "Creating platform test directories..."
                create_platform_dirs

                # Run platform upload preparation
                run_docker false phase2-5 "$@"

                # Generate instructions
                generate_platform_instructions
                ;;

            "3")
                echo "[Phase 3: Verification & Quality Metrics]"
                run_docker true phase3 "$@"
                ;;

            "4")
                echo "[Phase 4: Analysis & Visualization]"
                run_docker false phase4 "$@"
                ;;

            *)
                echo "Error: Invalid phase number: $PHASE"
                echo ""
                echo "Valid phases:"
                echo "  0    - Asset generation (separate step, run independently)"
                echo "  1    - C2PA manifest embedding"
                echo "  2    - Transformation pipeline"
                echo "  2.5  - Platform testing setup (optional)"
                echo "  3    - Verification & quality metrics"
                echo "  4    - Analysis & visualization"
                echo ""
                echo "Usage: c2pa phase <number> [options]"
                echo "Example: c2pa phase 0 --images 50 --videos 10"
                exit 1
                ;;
        esac
        ;;

    "run")
        echo "[Full Pipeline: Phases 1-4, starts from embedding]"
        echo "Note: Phase 0 (generation) is separate. Preset assets will be used."
        shift
        run_docker true run-all "$@"
        ;;

    "test")
        echo "[Quick Test Mode: Phases 1-4 with preset assets]"
        run_docker true run-all --test
        ;;

    "status")
        echo "[Pipeline Status Check]"
        run_docker false status
        ;;

    "setup")
        echo "[Setup: Extracting c2patool to local tools directory]"
        mkdir -p "$TOOLS_DIR/c2patool"
        docker run --rm -v "$TOOLS_DIR:/host-tools" "$IMAGE" \
            cp -r /workspace/tools/c2patool/. /host-tools/c2patool/
        if [ -f "$TOOLS_DIR/c2patool/c2patool" ]; then
            chmod +x "$TOOLS_DIR/c2patool/c2patool"
            echo "[✓] c2patool extracted to $TOOLS_DIR/c2patool/"
            "$TOOLS_DIR/c2patool/c2patool" --version
        else
            echo "[✗] Failed to extract c2patool"
            exit 1
        fi
        ;;

    "rename-returns")
        echo "[Rename Platform Returns]"
        echo "Standardizing filenames for returned platform assets..."
        run_docker false python scripts/processing/preprocessing/platform/rename_platform_returns.py
        echo ""
        echo "For WhatsApp files, also run:"
        echo "  c2pa shell"
        echo "  python scripts/processing/preprocessing/platform/rename_whatsapp_returns.py"
        ;;

    "shell")
        echo "[Interactive Shell]"
        docker run --rm -it $GPU_FLAG \
            -v "$OUTPUT_DIR:/workspace/data" \
            -v huggingface-cache:/workspace/.cache/huggingface \
            -v torch-cache:/workspace/.cache/torch \
            "$IMAGE" bash
        ;;

    "--help"|"-h"|"help")
        cat << 'HELP'
C2PA Robustness Research Pipeline - Docker Wrapper
===================================================

USAGE:
  c2pa <command> [options]

COMMANDS:
  phase 0         Generate AI assets (images with SD1.4, videos with SVD) - requires GPU
  phase 1         Embed C2PA manifests into assets using c2patool
  phase 2         Apply transformations (JPEG/PNG compression, H.264/H.265, resize, crop, rotate, trim)
  phase 2-5       Prepare assets for platform testing (optional, for social media round-trip tests)
  phase 3         Verify C2PA manifests and calculate quality metrics (PSNR, SSIM, VMAF)
  phase 4         Data analysis and visualization (exploratory plots or publication figures)
  run             Run complete pipeline (phases 1-4 sequentially)
  test            Quick test run with minimal assets
  status          Check pipeline execution status
  setup           Extract c2patool to local tools directory
  rename-returns  Rename downloaded platform files to standard format (run after phase 2.5 downloads)
  shell           Open interactive shell in container

OPTIONS:
  --test              Run in test mode (fewer assets, faster execution)
  --force             Force re-run even if checkpoint exists
  --publication       Generate F1-F7 publication figures (phase 4 and run)
  --skip-viz          Skip visualization generation (phase 4 only)
  --images N          Number of images to generate (phase 0 only)
  --videos N          Number of videos to generate (phase 0 only)
  --resume-from N     Resume from phase N, where N is 1-4 (run only)

EXAMPLES:
  c2pa phase 0 --images 50 --videos 10    # Generate 50 images + 10 videos
  c2pa phase 1                            # Sign assets with C2PA manifests
  c2pa phase 4 --publication              # Generate F1-F7 publication figures
  c2pa run --test                         # Quick test of full pipeline
  c2pa run --publication                  # Full run with publication figures
  c2pa run --resume-from 3                # Resume from phase 3

ENVIRONMENT VARIABLES:
  C2PA_IMAGE      Docker image (default: aitchem037/c2pa-research:latest)
  C2PA_DATA_DIR   Output directory (default: ./c2pa-results)
  C2PA_TOOLS_DIR  Tools directory (default: ./tools)

OUTPUT STRUCTURE:
  ./c2pa-results/
  +-- results/csv/                 CSV metrics files
      +-- final_metrics.csv        Main results
      +-- c2pa_validation.csv      C2PA verification
      +-- quality_metrics.csv      PSNR/SSIM/VMAF
  +-- results/analysis_results/
      +-- plots/                   Visualizations
      +-- csv/                     Analysis summaries
  +-- results/logs/                Execution logs

For detailed documentation, see README_DOCKER.md
HELP
        ;;

    *)
        if [ -z "$1" ]; then
            echo "Error: No command specified"
            echo "Run 'c2pa --help' for usage information"
            exit 1
        fi

        # Forward unknown commands directly to Docker
        run_docker true "$@"
        ;;
esac

# Show results summary if CSV exists
if [ -f "$OUTPUT_DIR/csv/final_metrics.csv" ]; then
    echo ""
    echo "+================================================================+"
    echo "| Results available in: $OUTPUT_DIR                              |"
    echo "| Metrics CSV: $OUTPUT_DIR/csv/final_metrics.csv                 |"
    echo "| Plots: $OUTPUT_DIR/plots/                                      |"
    echo "+================================================================+"
fi
