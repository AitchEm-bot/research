# =============================================================================
# DATA DIRECTORIES (Refactored Structure)
# =============================================================================

# Keep raw unsigned data (internal pipeline generation)
# These are small source files needed for reproducibility
# Keep: data/assets/raw_images/*.png (100 images, ~500MB total)
# Keep: data/assets/raw_videos/*.mp4 (50 videos, ~2GB total)
# Keep: data/assets/raw_images_for_videos/*.png (conditioning images)
# Keep: data/assets/raw_out_videos/*.mp4 (60 external videos, ~5GB total)

# Ignore metadata files for raw assets
data/assets/raw_images/*.json
data/assets/raw_images_for_videos/*.json
data/assets/raw_videos/*.json
data/assets/raw_out_videos/*.json
data/assets/raw_out_videos/prompts.md

# Prepared Assets - All signed/processed files (ignore everything)
# These can be regenerated from raw assets
data/prepared_assets/signed_assets/**/*.png
data/prepared_assets/signed_assets/**/*.jpg
data/prepared_assets/signed_assets/**/*.mp4
data/prepared_assets/signed_assets/**/*.json

# C2PA manifest extractions
data/prepared_assets/c2pa_manifests/

# Transformed assets - ignore all outputs
data/prepared_assets/transformed/**/*.png
data/prepared_assets/transformed/**/*.jpg
data/prepared_assets/transformed/**/*.jpeg
data/prepared_assets/transformed/**/*.mp4
data/prepared_assets/transformed/**/*.avi
data/prepared_assets/transformed/**/*.json
data/prepared_assets/transformed/**/*.log

# Platform tests (Phase 2.5) - ignore uploads/downloads
data/prepared_assets/platform_tests/**/uploads/*.png
data/prepared_assets/platform_tests/**/uploads/*.jpg
data/prepared_assets/platform_tests/**/uploads/*.mp4
data/prepared_assets/platform_tests/**/returned/*.png
data/prepared_assets/platform_tests/**/returned/*.jpg
data/prepared_assets/platform_tests/**/returned/*.mp4
data/prepared_assets/platform_tests/**/returned/*.json
data/prepared_assets/platform_tests/platform_manifest.csv
data/prepared_assets/platform_tests/auto_sample_tracking.csv
data/prepared_assets/platform_tests/rename_log.csv

# Results - All CSVs and analysis outputs (regenerable)
data/results/*.csv
data/results/logs/*.log

# Keep directory structure with .gitkeep files
!data/assets/raw_images/.gitkeep
!data/assets/raw_images_for_videos/.gitkeep
!data/assets/raw_videos/.gitkeep
!data/assets/raw_out_videos/.gitkeep
!data/assets/raw_out_videos/README.md
!data/prepared_assets/signed_assets/images/.gitkeep
!data/prepared_assets/signed_assets/videos/internal/.gitkeep
!data/prepared_assets/signed_assets/videos/external/.gitkeep
!data/prepared_assets/c2pa_manifests/.gitkeep
!data/prepared_assets/transformed/.gitkeep
!data/prepared_assets/platform_tests/**/.gitkeep
!data/prepared_assets/platform_tests/README_PHASE_2.5.md
!data/prepared_assets/platform_tests/platform_manifest_TEMPLATE.csv
!data/results/.gitkeep
!data/results/logs/.gitkeep

