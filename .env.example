# Environment Variables for C2PA Robustness Research Pipeline
# Copy this file to .env and customize for your environment

# ============================================================
# GPU Configuration
# ============================================================
# Select which GPU to use (0-based index)
CUDA_VISIBLE_DEVICES=0

# Memory optimization for limited VRAM (RTX 4060 = 8GB)
# Adjust based on your GPU memory
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# Enable CUDA optimizations
TORCH_CUDNN_V8_API_ENABLED=1
CUDA_MODULE_LOADING=LAZY

# ============================================================
# Model Cache Directories
# ============================================================
# HuggingFace models cache (Stable Diffusion, SVD)
HF_HOME=/workspace/.cache/huggingface
TRANSFORMERS_CACHE=/workspace/.cache/huggingface

# PyTorch model cache
TORCH_HOME=/workspace/.cache/torch

# ============================================================
# Tool Paths
# ============================================================
# C2PA command-line tool
C2PATOOL_PATH=/usr/local/bin/c2patool

# FFmpeg binary
FFMPEG_PATH=/usr/bin/ffmpeg

# VMAF model path (if using custom model)
VMAF_MODEL_PATH=/usr/share/model/vmaf_v0.6.1.json

# ============================================================
# Project Paths
# ============================================================
# Project root directory
PROJECT_ROOT=/workspace

# Data directory
DATA_DIR=/workspace/data

# Results directory
RESULTS_DIR=/workspace/data/results

# ============================================================
# Python Settings
# ============================================================
# Disable output buffering for real-time logs
PYTHONUNBUFFERED=1

# Python path
PYTHONPATH=/workspace:$PYTHONPATH

# ============================================================
# Pipeline Settings
# ============================================================
# Default batch size for generation (adjust for memory)
GENERATION_BATCH_SIZE=1

# Number of workers for data loading
NUM_WORKERS=4

# Enable mixed precision for faster processing
ENABLE_MIXED_PRECISION=true

# ============================================================
# Logging
# ============================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log directory
LOG_DIR=/workspace/data/results/logs

# ============================================================
# Docker-specific Settings
# ============================================================
# Container user (optional, for permissions)
# DOCKER_USER=1000:1000

# Time zone
TZ=UTC

# ============================================================
# Optional: API Keys (if needed for external services)
# ============================================================
# Example: HuggingFace API token for private models
# HF_TOKEN=your_token_here

# ============================================================
# Development Settings
# ============================================================
# Enable debug mode
DEBUG=false

# Test mode (use smaller datasets)
TEST_MODE=false

# Skip generation if assets exist
SKIP_GENERATION=false